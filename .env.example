# Copy to .env and fill in. Do not commit or share the real .env.
# Mist cloud host: api.mist.com (Global 01), api.gc1.mist.com, api.ac2.mist.com,
# api.gc2.mist.com, api.eu.mist.com, api.gc3.mist.com, api.ac5.mist.com ...
MIST_HOST=api.mist.com
MIST_USER=you@example.com
# Leave MIST_PASSWORD out to be prompted for it at each run instead.
MIST_PASSWORD=your_password_here
